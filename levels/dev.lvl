player 0 10 -4

# --- floor: I-shape, 3 slabs ---
# 0 top bar
brush  -6 -0.5 -3    6 0 0
# 1 central connector
brush  -1 -0.5 -8    1 0 -3
# 2 bottom bar
brush  -6 -0.5 -11   6 0 -8

# --- walls: 12 panels, offset 0.5 into the solid ---
# 3 z=0, normal +Z
brush  -6 0 0        6 2 0.5
# 4 x=6 upper, normal +X
brush   6 0 -3       6.5 2 0
# 5 z=-3 right, normal -Z
brush   1 0 -3.5     6 2 -3
# 6 x=-1, normal -X
brush  -1.5 0 -8    -1 2 -3
# 7 x=-6 upper, normal -X
brush  -6.5 0 -3    -6 2 0
# 8 z=-3 left, normal -Z
brush  -6 0 -3.5    -1 2 -3
# 9 z=-8 left, normal +Z
brush  -6 0 -8      -1 2 -7.5
# 10 x=-6 lower, normal -X
brush  -6.5 0 -11   -6 2 -8
# 11 z=-11, normal -Z
brush  -6 0 -11.5    6 2 -11
# 12 x=6 lower, normal +X
brush   6 0 -11      6.5 2 -8
# 13 z=-8 right, normal +Z
brush   1 0 -8       6 2 -7.5
# 14 x=1, normal +X
brush   1 0 -8       1.5 2 -3
# 15 door panel across the central corridor
brush  -1 0 -6.5     1 2 -6

# Key before the door, in the central corridor.
key 1 0 0.5 -4.5

# Door needs key id 1. Traps: one floor and one wall surface.
trap 1 10
trap 6 10
trap 7 10
door 15 1

exit -1 0 -1  1 2 0
light 0 2 -5  1 1 1  1.0
